# Permanence Mobility — Environment

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOW_SEED=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Stripe Connect (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# Email (Resend)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Permanence Mobility <notifications@your-verified-domain.com>

# SMS (Twilio-ready; optional until configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Admin bootstrap (first super admin email after signup)
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
